# Compose control variables. Store the real file outside the repository, for example:
# /etc/clawbot/production.env (mode 0600, owned by the deploy user).
# Every image value must include an immutable @sha256 digest.

SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest@sha256:REPLACE
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE
RABBITMQ_IMAGE=rabbitmq:3.13-management@sha256:REPLACE
QDRANT_IMAGE=qdrant/qdrant:v1.14.1@sha256:REPLACE
SEARXNG_IMAGE=searxng/searxng:2025.8.1@sha256:REPLACE
MINIO_IMAGE=minio/minio:RELEASE.2025-02-28T09-55-16Z@sha256:REPLACE
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# Application image digests are supplied only by the immutable GitHub Actions release manifest.

# Temporary IP staging ingress. Replace with 80/443 when TLS is ready.
CLAWBOT_HTTP_PORT=58080

# Licensed SQL Server Standard or Enterprise only.
MSSQL_PID=Standard
MSSQL_SA_PASSWORD=REPLACE_AND_ROTATE
APP_SQL_USER=clawbot_app
APP_SQL_PASSWORD=REPLACE_AND_ROTATE
SQLSERVER_BACKUP_DIR=/var/backups/clawbot
REDIS_PASSWORD=REPLACE_AND_ROTATE
RABBITMQ_USER=clawbot
RABBITMQ_PASSWORD=REPLACE_AND_ROTATE
MINIO_ROOT_USER=clawbot-root
MINIO_ROOT_PASSWORD=REPLACE_AND_ROTATE
MINIO_APP_ACCESS_KEY=REPLACE
MINIO_APP_SECRET_KEY=REPLACE
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_64_BYTE_KEY
AGENT_SERVICE_AUTH_SIGNING_KEY=REPLACE_WITH_DISTINCT_RANDOM_64_BYTE_BASE64_KEY
AGENT_SERVICE_TLS_CERTIFICATE_PATH=/etc/clawbot/certs/agentservice-grpc.pfx
AGENT_SERVICE_TLS_CERTIFICATE_PASSWORD=REPLACE_AND_ROTATE
AGENT_SERVICE_TLS_CA_CERTIFICATE_PATH=/etc/clawbot/certs/agentservice-ca.pem
ENCRYPTION_BASE64_KEY=REPLACE_WITH_ROTATED_32_BYTE_BASE64_KEY
PANCAKE_WEBHOOK_SECRET=REPLACE

# The file is mounted read-only into API and AgentService only.
CLAWBOT_RUNTIME_ENV_FILE=/etc/clawbot/runtime.env
SEARXNG_SETTINGS_FILE=/etc/clawbot/searxng/settings.yml
