# ============================================
# ClawBot Backend - Environment Variables (Deploy)
# ============================================

# === Database / Infrastructure ===
MSSQL_SA_PASSWORD=Clawbot!2026
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MINIO_USER=minio
MINIO_PASSWORD=minio12345
METABASE_PASSWORD=metabase12345

# === Bat/tat Demo Mode ===
DEMO_MODE=true

# === Pancake Access Token (cho polling/doc tin nhan) ===
PANCAKE_ACCESS_TOKEN=

# === Pancake Page Access Token (cho gui tin nhan) ===
PANCAKE_PAGE_ACCESS_TOKEN=

# === Pancake Webhook Secret ===
PANCAKE_WEBHOOK_SECRET=

# === Demo Options ===
DEMO_MASK_PII=true
DEMO_SKIP_HMAC=true
DEMO_WATCHDOG_INTERVAL_SECONDS=60
DEMO_TRACE_TTL_MINUTES=60

# Content generation / research / publishing
Content__Llm__BaseUrl=https://api.openai.com/v1
Content__Llm__ApiKey=replace-with-openai-compatible-key
Content__Llm__Model=gpt-4o-mini
Content__Llm__MaxOutputTokens=1200
Content__Trends__YouTube__ApiKey=replace-with-youtube-data-api-key
Content__Trends__TikTok__Url=https://ads.tiktok.com/business/creativecenter/inspiration/popular/hashtag/mobile/en
Content__Trends__Baidu__Enabled=false
Content__Trends__Baidu__Url=
Content__Publisher__Endpoint=https://publisher.example/api/posts
Content__Publisher__Token=replace-with-buffer-later-or-ayrshare-token

# Ads automation (Meta + TikTok)
Ads__Meta__Enabled=false
Ads__Meta__Endpoint=https://graph.facebook.com/v21.0
Ads__Meta__AccessToken=replace-with-meta-access-token
Ads__Meta__AdAccountId=replace-with-ad-account-id
Ads__Meta__WebhookSecret=replace-with-meta-webhook-secret
Ads__TikTok__Enabled=false
Ads__TikTok__Endpoint=https://business-api.tiktok.com/open_api/v1.3
Ads__TikTok__AccessToken=replace-with-tiktok-access-token
Ads__TikTok__AdvertiserId=replace-with-advertiser-id
Ads__TikTok__WebhookSecret=replace-with-tiktok-webhook-secret

# P1 Skills (all external off by default - heuristic baselines always work)
Skills__Summarizer__PromptTemplate=Summarize the following conversation in at most {maxWords} words. Return JSON: {"summary":"...","key_points":["..."]}. Use the same language as the conversation.\n\n{turns}
Skills__Toxicity__SidecarUrl=
Skills__Toxicity__BlockThreshold=0.7
Skills__Language__SidecarUrl=
Skills__Spam__AkismetKey=
Skills__ContactEnrich__Enabled=false
Skills__ContactEnrich__HunterApiKey=replace-with-hunter-api-key
Skills__ContactEnrich__HunterBaseUrl=https://api.hunter.io/v2
Skills__ContactEnrich__ApolloApiKey=replace-with-apollo-api-key
Skills__ContactEnrich__ApolloBaseUrl=https://api.apollo.io/v1
