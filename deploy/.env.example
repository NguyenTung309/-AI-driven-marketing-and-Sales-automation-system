# ============================================
# ClawBot Backend - Environment Variables (Deploy)
# ============================================

# === Database / Infrastructure ===
# run-all.bat fills blank local secrets with cryptographically random values in deploy/.env.
# For shared/staging/production environments, inject every secret from a secret manager.
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=
# Dedicated API-to-AgentService signing key; never reuse JWT_SIGNING_KEY.
AGENT_SERVICE_AUTH_SIGNING_KEY=
ENCRYPTION_BASE64_KEY=
RABBITMQ_USER=clawbot
RABBITMQ_PASSWORD=
MINIO_USER=clawbot
MINIO_PASSWORD=
METABASE_PASSWORD=

# Optional Web Push VAPID pair. Keep the private key outside source control.
# Generate a fresh pair with: npx web-push generate-vapid-keys
# Leave both blank to disable web push; the notification feed, bell, and email still work.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# Go-live readiness / ops script aliases
PANCAKE_BASE_URL=https://pancake.vn/api/v1
PANCAKE_ACCESS_TOKEN=
PANCAKE_PAGE_ACCESS_TOKEN=
# SPEC-16 Module M-1: optional user access token — at startup the bootstrap seeder mints + stores a page token
# from it into the encrypted inbox credential store. Prefer this over PANCAKE_PAGE_ACCESS_TOKEN when you only have a user token.
PANCAKE_USER_ACCESS_TOKEN=
PANCAKE_PAGE_ID=
PANCAKE_TENANT_SLUG=hoc-ba
# Required when bootstrapping from PANCAKE_PAGE_ACCESS_TOKEN (the page-token path cannot infer it).
# With PANCAKE_USER_ACCESS_TOKEN the seeder reads the platform while listing pages, so this may stay blank.
# Values match the Pancake page platform, e.g. facebook, instagram, tiktok, zalo.
PANCAKE_PLATFORM=
CLAWBOT_PUBLIC_BASE_URL=https://clawbot.example
PANCAKE_WEBHOOK_SECRET=
# NOTE: the live Pancake token was removed from appsettings.json. Set PANCAKE_PAGE_ACCESS_TOKEN (or
# PANCAKE_USER_ACCESS_TOKEN) here; the AgentService bootstrap seeder stores it on the encrypted inbox row
# for the "default" tenant at startup. After that, this env var can be dropped (page tokens never expire).
PANCAKE_WEBHOOK_PAYLOAD=deploy/samples/pancake-comment-webhook.json
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
EMBEDDING_API_KEY=replace-with-openai-compatible-embedding-key
CONTENT_LLM_API_KEY=replace-with-openai-compatible-content-key
TIKTOK_ACCESS_TOKEN=replace-with-tiktok-access-token
TIKTOK_ADVERTISER_ID=replace-with-tiktok-advertiser-id
CONTENT_PUBLISHER_BASE_URL=https://publisher.example/api/posts
CONTENT_PUBLISHER_API_KEY=replace-with-buffer-later-or-ayrshare-token

# .NET config keys accepted by the app and the go-live readiness gate
Channels__Pancake__BaseUrl=https://pages.fm/api/public_api/v1
Channels__Pancake__AccessToken=
Channels__Pancake__WebhookSecret=
Gateway__Pancake__WebhookSecret=

# Optional Meta bootstrap fallback. Tenant admins can save an encrypted override in the system UI.
Meta__Graph__AppId=
Meta__Graph__AppSecret=
Meta__Graph__ConfigurationId=
Meta__Graph__AuthorizationMode=development_user
Meta__Graph__WebhookVerifyToken=
Meta__Graph__RedirectUri=http://localhost:15873/api/admin/meta/callback
Meta__Graph__FrontendReturnUrl=http://localhost:15876/system
Meta__Graph__ApiVersion=v25.0
Anthropic__ApiKey=replace-with-anthropic-api-key
Embedding__ApiKey=replace-with-openai-compatible-embedding-key
Embedding__Model=text-embedding-3-small
Embedding__Dimension=1536
Embedding__BaseUrl=
# === Bat/tat Demo Mode ===
DEMO_MODE=true

# === Demo Options ===
DEMO_MASK_PII=true
DEMO_SKIP_HMAC=true
DEMO_WATCHDOG_INTERVAL_SECONDS=60
DEMO_TRACE_TTL_MINUTES=60

# Content generation / research / publishing
Content__Llm__BaseUrl=https://api.openai.com/v1
Content__Llm__ApiKey=replace-with-openai-compatible-key
Content__Llm__Model=gpt-4o-mini
Content__Llm__MaxOutputTokens=1200
Content__Trends__YouTube__ApiKey=replace-with-youtube-data-api-key
Content__Trends__TikTok__Url=https://ads.tiktok.com/business/creativecenter/inspiration/popular/hashtag/mobile/en
Content__Trends__Baidu__Enabled=false
Content__Trends__Baidu__Url=
Content__Publisher__Endpoint=https://publisher.example/api/posts
Content__Publisher__Token=replace-with-buffer-later-or-ayrshare-token

# P1 Skills (all external off by default - heuristic baselines always work)
Skills__Summarizer__PromptTemplate=Summarize the following conversation in at most {maxWords} words. Return JSON: {"summary":"...","key_points":["..."]}. Use the same language as the conversation.\n\n{turns}
Skills__Toxicity__SidecarUrl=
Skills__Toxicity__BlockThreshold=0.7
Skills__Language__SidecarUrl=
Skills__Spam__AkismetKey=
Skills__ContactEnrich__Enabled=false
Skills__ContactEnrich__HunterApiKey=replace-with-hunter-api-key
Skills__ContactEnrich__HunterBaseUrl=https://api.hunter.io/v2
Skills__ContactEnrich__ApolloApiKey=replace-with-apollo-api-key
Skills__ContactEnrich__ApolloBaseUrl=https://api.apollo.io/v1
