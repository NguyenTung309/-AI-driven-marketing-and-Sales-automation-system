{
  "name": "clawbot-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "node e2e/run-mock.mjs",
    "test:e2e:publish": "node e2e/run-publish-mock.mjs",
    "test:e2e:platform": "node e2e/run-platform-focus.mjs",
    "test:e2e:platform:spec": "playwright test e2e/content-platform-focus.spec.ts --config=playwright.config.mjs",
    "test:e2e:all": "node e2e/run-mock.mjs && node e2e/run-publish-mock.mjs && npm run test:e2e:platform",
    "test:e2e:pw": "playwright test --config=playwright.config.mjs",
    "test:e2e:ui": "playwright test --config=playwright.config.mjs --ui",
    "test:e2e:live": "node e2e/run-live.mjs",
    "test:e2e:publish:live": "node e2e/run-publish-live.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
