# ============================================
# ClawBot Backend - Environment Variables
# ============================================
# Cách 1: Set trong Properties/launchSettings.json (recommended cho dev)
# Cách 2: Set system env vars truoc khi chay dotnet run
# Cách 3: S?a appsettings.json -> section Demo

# === Bat/tat Demo Mode ===
# Set = true de bat demo endpoints + UI + watchdog
DEMO_MODE=false

# === Pancake Access Token (cho polling/doc tin nhan) ===
# Dung de poll conversations tu Pancake API (GET conversations)
# Neu khong set, polling service se skip
# Co the update runtime qua API: POST /api/demo/config/token
PANCAKE_ACCESS_TOKEN=

# === Pancake Page Access Token (cho gui tin nhan) ===
# Dung de gui reply qua Pancake API (POST messages)
# Can co quyen send_message tren page
# Co the update runtime qua API: POST /api/demo/config/token (field: pageAccessToken)
PANCAKE_PAGE_ACCESS_TOKEN=

# === Pancake Page ID (cho polling) ===
# Page ID de poll conversations tu Pancake API
# Co the update runtime qua API: POST /api/demo/config/token (field: pageId)
PANCAKE_PAGE_ID=

# === Pancake Webhook Secret (cho HMAC verify) ===
# Neu khong set va SkipHmac=false, webhook se tra ve 401
# Co the update runtime qua API: POST /api/demo/config/webhook-secret
PANCAKE_WEBHOOK_SECRET=

# === Demo Options (override appsettings) ===
DEMO_MASK_PII=true
DEMO_SKIP_HMAC=false
DEMO_WATCHDOG_INTERVAL_SECONDS=60
DEMO_TRACE_TTL_MINUTES=60
DEMO_SSE_REPLAY_COUNT=10