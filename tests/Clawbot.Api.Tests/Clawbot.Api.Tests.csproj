  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\api\Clawbot.Api\Clawbot.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
